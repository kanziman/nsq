# 임포트 파이프라인 — yt-dlp(YouTube 오디오/자막 추출) 설정
# 실행할 yt-dlp 바이너리 경로. 미설정 시 PATH의 `yt-dlp`를 사용.
YT_DLP_PATH=yt-dlp
# yt-dlp 프로세스당 타임아웃(ms). 미설정 시 300000(300초).
YT_DLP_TIMEOUT_MS=300000

# 임포트 파이프라인 — 대본 한국어 번역(OpenRouter) 설정
# OpenRouter API 키(필수). 미설정 시 번역 단계는 no-op으로 건너뛴다(임포트는 정상 완료).
OPENROUTER_API_KEY=
# 번역에 사용할 모델. 미설정 시 google/gemini-3.5-flash.
# (번역은 reasoning이 불필요해 flash + reasoning 비활성화로 지연·비용을 최소화한다.)
OPENROUTER_MODEL=google/gemini-3.5-flash
# OpenRouter API 베이스 URL. 미설정 시 https://openrouter.ai/api/v1.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# AI 튜터용 모델 설정
TUTOR_MODEL=anthropic/claude-haiku-4-5

# Cloudflare R2 Object Storage (S3 호환 API) — 오디오 자산 스토리지 (#157)
# 아래 자격증명은 로컬 퍼블리시(S4)에서만 사용한다. 실제 값은 .env.local에 두고
# 절대 커밋하지 않는다(.env.example은 git 추적 템플릿이므로 빈 placeholder만 둔다).
# R2 S3 API 엔드포인트 (예: https://<ACCOUNT_ID>.r2.cloudflarestorage.com)
R2_ENDPOINT=
# R2 API 액세스 키 ID / 비밀 키 (Cloudflare 대시보드에서 발급)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# 오디오를 저장할 버킷명
R2_BUCKET_NAME=nsq-shadowing-assets
# 버킷 공개 base URL — 클라이언트 오디오 스트리밍에 사용된다.
# 브라우저에 노출되므로 반드시 NEXT_PUBLIC_ 접두사를 쓴다.
# 예: https://pub-xxxxxxxx.r2.dev 또는 커스텀 도메인
NEXT_PUBLIC_R2_BASE_URL=

