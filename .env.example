# 임포트 파이프라인 — yt-dlp(YouTube 오디오/자막 추출) 설정
# 실행할 yt-dlp 바이너리 경로. 미설정 시 PATH의 `yt-dlp`를 사용.
YT_DLP_PATH=yt-dlp
# yt-dlp 프로세스당 타임아웃(ms). 미설정 시 300000(300초).
YT_DLP_TIMEOUT_MS=300000

# 임포트 파이프라인 — 대본 한국어 번역(OpenRouter) 설정
# OpenRouter API 키(필수). 미설정 시 번역 단계는 no-op으로 건너뛴다(임포트는 정상 완료).
OPENROUTER_API_KEY=
# 번역에 사용할 모델. 미설정 시 google/gemini-2.5-pro.
OPENROUTER_MODEL=google/gemini-2.5-pro
# OpenRouter API 베이스 URL. 미설정 시 https://openrouter.ai/api/v1.
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
